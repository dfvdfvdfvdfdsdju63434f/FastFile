<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- Generate your own GUID for a real deployment: https://www.guidgenerator.com/ -->
  <Id>3f6a2f2e-6b1d-4a2e-9b0a-7c1e9d0f1234</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Your Company Name</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="Smart Filing" />
  <Description DefaultValue="Suggests the best folder to file the open email in, based on the subject, sender, and body." />

  <!-- REPLACE the placeholder domain below with your GitHub Pages URL, e.g.
       https://dfvdfvdfvdfdsdju63434f.github.io/FastFile -->
  <IconUrl DefaultValue="https://dfvdfvdfvdfdsdju63434f.github.io/FastFile/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://dfvdfvdfvdfdsdju63434f.github.io/FastFile/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/dfvdfvdfvdfdsdju63434f/FastFile" />

  <AppDomains>
    <AppDomain>https://dfvdfvdfvdfdsdju63434f.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://dfvdfvdfvdfdsdju63434f.github.io/FastFile/taskpane.html" />
        <RequestedHeight>500</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!--
    ReadWriteMailbox is required because the add-in uses makeEwsRequestAsync
    to (a) enumerate mail folders and (b) move the open item into the chosen
    folder. It does NOT grant network/backend access to other mailboxes —
    it only unlocks EWS calls scoped to the signed-in user's own mailbox.
  -->
  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- Required boilerplate host file for the command surface, even though
               our only control action is ShowTaskpane (no ExecuteFunction calls). -->
          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="smartFilingGroup">
                <Label resid="GroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://dfvdfvdfvdfdsdju63434f.github.io/FastFile/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://dfvdfvdfvdfdsdju63434f.github.io/FastFile/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://dfvdfvdfvdfdsdju63434f.github.io/FastFile/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://dfvdfvdfvdfdsdju63434f.github.io/FastFile/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://dfvdfvdfvdfdsdju63434f.github.io/FastFile/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Smart Filing" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Suggest Folder" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open Smart Filing to see a suggested folder for this email." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
